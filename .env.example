# ============================================================
# 多 Agent 协作智能旅行规划系统 - 环境变量示例
# ============================================================
# 用法：
#   1. 复制本文件为 .env  ：cp .env.example .env
#   2. 把下面的占位符替换为你真实的 API Key
#   3. 切勿把 .env 提交到 Git（已在 .gitignore 中忽略）
# ============================================================

# ── 通义千问 (DashScope) API 配置 ─────────────────────
# 获取地址：https://dashscope.aliyun.com/
# 在「模型服务灵积」控制台创建 API Key
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ── Tavily Search API 配置 ────────────────────────────
# 获取地址：https://tavily.com/
# 注册后在 Dashboard 获取 API Key（每月有免费额度）
TAVILY_API_KEY=your_tavily_api_key_here

# ── 使用的模型（可选，默认 qwen-plus）─────────────────
# 可选值：qwen-plus / qwen-turbo / qwen-max 等
LLM_MODEL=qwen-plus
